# =============================================================================
# Triton Inference Server — Environment Variables (Example)
# =============================================================================
# 단일 호스트 production Compose용 예시입니다.
# cp .env.example .env.prod
# =============================================================================

# ---------------------------------------------------------------------------
# Triton Server
# ---------------------------------------------------------------------------
# CI가 model_repository를 포함해 만든 commit SHA tag 또는 digest
TRITON_IMAGE=ghcr.io/your-org/triton-infer-server-handbook:REPLACE_WITH_40_CHAR_COMMIT_SHA
TRITON_HTTP_PORT=8000
TRITON_GRPC_PORT=8001
TRITON_METRICS_PORT=8002
HOST_BIND_ADDRESS=127.0.0.1

# Monitoring UI. Production 시작 전 빈 비밀번호를 반드시 교체합니다.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Response Cache
# ---------------------------------------------------------------------------
CACHE_SIZE=67108864

# Redis/TLS/tracing은 환경변수만 설정해서 활성화되지 않습니다. 실제 server args와
# sidecar/gateway 배포는 configs/cache, configs/tls, configs/tracing을 참고해 추가합니다.
