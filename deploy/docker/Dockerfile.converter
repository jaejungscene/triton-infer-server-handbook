# =============================================================================
# Dockerfile.converter — 모델 변환 전용 이미지 (CI에서 사용)
# =============================================================================
# trtexec, torch, onnx 등 변환 도구를 포함
# CI 파이프라인에서 ONNX → TensorRT 변환 등에 사용
# =============================================================================

# Serving image와 같은 검증된 Triton runtime을 사용합니다.
ARG TRITON_IMAGE=nvcr.io/nvidia/tritonserver:24.08-py3@sha256:0b6a7449ea6a46fd167376d40418b169ed82cd36addc6f6c56fe2cbda4294e13
FROM ${TRITON_IMAGE}

COPY requirements-converter.txt /tmp/requirements-converter.txt
RUN pip install --no-cache-dir -r /tmp/requirements-converter.txt

COPY scripts/convert/ /opt/convert/

WORKDIR /workspace
ENTRYPOINT ["/bin/bash"]
