# =============================================================================
# Ensemble Pipeline — Postprocessor config.pbtxt
# =============================================================================
# Python backend로 classification logits에 softmax 적용
# =============================================================================

name: "postprocessor"
backend: "python"
max_batch_size: 8

input [
  {
    name: "RAW_OUTPUT"
    data_type: TYPE_FP32
    dims: [-1]
  }
]

output [
  {
    name: "FINAL_OUTPUT"
    data_type: TYPE_FP32
    dims: [-1]                  # 최종 결과 shape
  }
]

dynamic_batching {
  preferred_batch_size: [4, 8]
  max_queue_delay_microseconds: 100
}

instance_group [
  {
    count: 1
    kind: KIND_CPU
  }
]

# 출력이 이미 확률이면 "identity"로 바꿉니다.
parameters: { key: "mode" value: { string_value: "softmax" } }
