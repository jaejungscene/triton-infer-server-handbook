# Object Detection — Postprocessor (NMS + Scale Recovery)

name: "od_postprocessor"
backend: "python"
max_batch_size: 8

input [
  {
    name: "DETECTIONS"
    data_type: TYPE_FP32
    dims: [-1, 7]
  },
  {
    name: "IMAGE_METADATA"
    data_type: TYPE_FP32
    dims: [5]
  }
]

output [
  {
    name: "BBOXES"
    data_type: TYPE_FP32
    dims: [100, 4]
  },
  {
    name: "SCORES"
    data_type: TYPE_FP32
    dims: [100]
  },
  {
    name: "CLASS_IDS"
    data_type: TYPE_INT32
    dims: [100]
  },
  {
    name: "NUM_DETECTIONS"
    data_type: TYPE_INT32
    dims: [1]
  }
]

dynamic_batching {
  preferred_batch_size: [4, 8]
  max_queue_delay_microseconds: 100
}

instance_group [{ count: 1, kind: KIND_CPU }]

parameters: { key: "confidence_threshold" value: { string_value: "0.5" } }
parameters: { key: "nms_threshold" value: { string_value: "0.45" } }
parameters: { key: "max_detections" value: { string_value: "100" } }
