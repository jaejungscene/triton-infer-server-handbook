{
  "annotations": {
    "list": []
  },
  "description": "Triton Inference Server Monitoring Dashboard",
  "editable": false,
  "datasource": {"type": "prometheus", "uid": "prometheus"},
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "Throughput (infer/sec)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum by (model, version) (rate(nv_inference_request_success[5m]))",
          "legendFormat": "{{ model }}"
        }
      ]
    },
    {
      "title": "Average Request / Queue Latency (ms)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "sum by (model, version) (rate(nv_inference_request_duration_us[5m])) / sum by (model, version) (rate(nv_inference_request_success[5m])) / 1000",
          "legendFormat": "request {{ model }} v{{ version }}"
        },
        {
          "expr": "sum by (model, version) (rate(nv_inference_queue_duration_us[5m])) / sum by (model, version) (rate(nv_inference_request_success[5m])) / 1000",
          "legendFormat": "queue {{ model }} v{{ version }}"
        }
      ]
    },
    {
      "title": "Inference / Execution Rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "sum by (model, version) (rate(nv_inference_count[5m]))",
          "legendFormat": "inference {{ model }}"
        },
        {
          "expr": "sum by (model, version) (rate(nv_inference_exec_count[5m]))",
          "legendFormat": "execution {{ model }}"
        }
      ]
    },
    {
      "title": "GPU Utilization (%)",
      "type": "gauge",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 8},
      "targets": [
        {
          "expr": "nv_gpu_utilization * 100",
          "legendFormat": "GPU {{ gpu_uuid }}"
        }
      ]
    },
    {
      "title": "GPU Memory Usage (%)",
      "type": "gauge",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 8},
      "targets": [
        {
          "expr": "nv_gpu_memory_used_bytes / nv_gpu_memory_total_bytes * 100",
          "legendFormat": "GPU {{ gpu_uuid }}"
        }
      ]
    },
    {
      "title": "Cache Hit Rate",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 16},
      "targets": [
        {
          "expr": "sum by (model, version) (rate(nv_cache_num_hits_per_model[5m])) / (sum by (model, version) (rate(nv_cache_num_hits_per_model[5m])) + sum by (model, version) (rate(nv_cache_num_misses_per_model[5m])))",
          "legendFormat": "{{ model }}"
        }
      ]
    },
    {
      "title": "Error Rate",
      "type": "timeseries",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 16},
      "targets": [
        {
          "expr": "sum by (model, version) (rate(nv_inference_request_failure[5m])) / (sum by (model, version) (rate(nv_inference_request_success[5m])) + sum by (model, version) (rate(nv_inference_request_failure[5m])))",
          "legendFormat": "{{ model }}"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["triton", "inference", "gpu"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "refresh": "30s",
  "title": "Triton Inference Server",
  "uid": "triton-dashboard"
}
